{
  "name": "imagination-machine",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n WEB,DECK \"npm:dev:web\" \"npm:dev:deck\"",
    "dev:web": "vite --open",
    "dev:deck": "tsx watch bridge/streamdeck.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/press-start-2p": "^5.1.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "@elgato-stream-deck/node": "^7.6.3",
    "sharp": "^0.34.4",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "^5.9.3",
    "vite": "^7.1.7",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.6"
  }
}
